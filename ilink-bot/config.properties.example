api.key=把你的key填在这里
reply.mode=text
router.model=Qwen/Qwen3.5-9B
document.model=Qwen/Qwen3.5-9B
request.timeout.seconds=120
document.request.timeout.seconds=240
document.max_text_chars=40000
tts.voice.default=FunAudioLLM/CosyVoice2-0.5B:alex
tts.voice.boy=FunAudioLLM/CosyVoice2-0.5B:david
tts.voice.girl=FunAudioLLM/CosyVoice2-0.5B:diana
tts.voice.male=FunAudioLLM/CosyVoice2-0.5B:charles
tts.voice.female=FunAudioLLM/CosyVoice2-0.5B:anna
tts.voice.warm=FunAudioLLM/CosyVoice2-0.5B:claire
tts.voice.lively=FunAudioLLM/CosyVoice2-0.5B:david
audio.analysis.only_when_requested=true
audio.dir=data/audio
media.dir=data/media
ffmpeg.command=ffmpeg
silk.decoder.command=auto

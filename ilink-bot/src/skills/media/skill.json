{
  "name": "media",
  "description": "图片、语音与视觉内容处理",
  "version": "1.0.0",
  "enabled": true,
  "requiresApproval": false,
  "toolNames": ["generate_image", "analyze_image", "edit_image", "transcribe_audio", "synthesize_speech"],
  "capabilities": [
    {"name":"draw","description":"生成一张新图片","parameterHint":"en_prompt, cn_description, image_size","interactive":true},
    {"name":"draw_size","description":"补充上一轮绘图尺寸","parameterHint":"image_size","interactive":true},
    {"name":"image_action","description":"分析、解题或修改已发送图片","parameterHint":"image_action, image_prompt","interactive":true},
    {"name":"audio_transcribe","description":"转写历史语音","parameterHint":"audio_source, audio_index","interactive":false},
    {"name":"visual_card","description":"生成业务卡片、计划表、证书或互动卡片","parameterHint":"action_text","interactive":true}
  ]
}

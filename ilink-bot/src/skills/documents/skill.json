{
  "name": "documents",
  "description": "文件理解、生成和编辑",
  "version": "1.0.0",
  "enabled": true,
  "requiresApproval": false,
  "toolNames": ["ask_document", "generate_document", "edit_document", "generate_plan_document"],
  "capabilities": [
    {"name":"document_summary","description":"总结当前文件","parameterHint":"document_action=summary","interactive":false},
    {"name":"document_question","description":"基于当前文件回答问题","parameterHint":"document_action=question","interactive":false},
    {"name":"generate_file","description":"从零创建新文件","parameterHint":"output_file_type","interactive":true},
    {"name":"document_edit","description":"编辑当前文件或转换格式","parameterHint":"document_action=edit, output_file_type","interactive":true}
  ]
}

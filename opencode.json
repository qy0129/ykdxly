{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["router.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  },
  "references": {
    "team-standard": {
      "path": "TEAM_CODING_STANDARD.md",
      "description": "五人小组编码规范，开发前必读"
    },
    "resources": {
      "path": "ilink-bot/src/main/resources",
      "description": "项目资源文件：模板、人设、静态资源"
    }
  }
}

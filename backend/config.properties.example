# 本地开发配置。复制为 config.properties 后填写真实值；不要提交 config.properties。
database.url=jdbc:mysql://127.0.0.1:3306/changlu_planner?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
database.username=root
database.password=

# AI 复盘功能可选；留空时该功能不可用。
api.key=
api.url=https://api.siliconflow.cn/v1/chat/completions
ai.model=Qwen/Qwen3.5-9B

# 天气简报功能可选。
amap.api.key=
amap.api.base-url=https://restapi.amap.com/v3
briefing.default.location=杭州
briefing.news.enabled=true

# 旅行 Agent：地图、天气、景点和路径查询均复用上方高德 Key；未配置时会明确降级。
travel.model.max-tokens=4800
travel.model.timeout-seconds=120
travel.location.ip-fallback-enabled=false
travel.geocoding.cache-hours=24
travel.weather.cache-hours=6
travel.routing.cache-hours=1
travel.refresh.enabled=true
travel.refresh.daily-hours=24
travel.refresh.urgent-hours=6
travel.refresh.retry-base-minutes=15

# 微信消息里的网页地址。局域网使用时填 http://电脑IP:8081/。
web.url=
# web.directory 可选；留空时自动寻找 web/dist 或 ../web/dist。
web.directory=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changlu.local/schemas/subagents/travel/output.schema.json",
  "title": "Travel Subagent Output",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["completed", "waiting_user", "waiting_confirmation", "failed", "cancelled"]
    },
    "message": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "request": { "type": "object" },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date" },
              "title": { "type": "string" },
              "activities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attractionId": { "type": "string" },
                    "attractionName": { "type": "string" },
                    "startTime": { "type": "string" },
                    "durationMinutes": { "type": "integer", "minimum": 1 },
                    "lat": { "type": ["number", "null"] },
                    "lng": { "type": ["number", "null"] },
                    "coordinateSystem": { "type": "string" },
                    "indoor": { "type": "boolean" },
                    "requiresReservation": { "type": ["boolean", "null"] },
                    "openingHours": { "type": "string" },
                    "transitFromPrevious": { "type": "object" },
                    "backupActivity": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "preparationTasks": { "type": "array" },
        "budgetEstimate": { "type": "object" },
        "sources": { "type": "array" },
        "risks": { "type": "array" },
        "questions": { "type": "array" },
        "planningInstruction": { "type": "string" },
        "locationContext": { "type": "object" },
        "weather": { "type": "array" },
        "attractions": { "type": "array" },
        "transitMatrix": { "type": "array" },
        "alternativePlans": { "type": "array" }
      },
      "required": ["request", "days", "preparationTasks", "budgetEstimate", "sources", "risks", "questions", "planningInstruction"]
    },
    "errors": { "type": "array" },
    "traceId": { "type": "string" },
    "requiresConfirmation": { "type": "boolean" },
    "draftId": { "type": ["string", "null"] }
  },
  "required": ["schemaVersion", "status", "message", "data", "errors", "traceId", "requiresConfirmation", "draftId"]
}

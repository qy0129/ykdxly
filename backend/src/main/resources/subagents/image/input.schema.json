{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changlu.local/schemas/subagents/image/input.schema.json",
  "title": "Image Generation Subagent Input",
  "type": "object",
  "properties": {
    "message": { "type": "string", "minLength": 1 },
    "arguments": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "图片内容描述，必填，最多 1000 字。",
          "maxLength": 1000
        },
        "size": {
          "type": "string",
          "enum": ["1024x1024", "1792x1024", "1024x1792"],
          "description": "图片尺寸，默认 1024x1024。",
          "default": "1024x1024"
        },
        "style": {
          "type": "string",
          "enum": ["default", "realistic", "anime", "watercolor", "3d", "line-art", "minimalist"],
          "description": "图片风格，默认 default。",
          "default": "default"
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "生成质量 1-3，默认 2。",
          "default": 2
        },
        "mode": {
          "type": "string",
          "enum": ["single", "batch"],
          "description": "生成模式，batch 需要用户确认。",
          "default": "single"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "批量生成的张数，大于 1 时需用户确认。",
          "default": 1
        },
        "confirmed": {
          "type": "boolean",
          "description": "服务端草案确认标记，仅由后端写入。",
          "default": false
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"],
          "description": "操作类型，update/delete 需要用户确认。",
          "default": "create"
        },
        "imageId": {
          "type": "string",
          "description": "update/delete 操作所需的目标图片 id。"
        },
        "idempotencyKey": {
          "type": "string",
          "description": "可选幂等键，缺省时由运行追踪 id 与描述自动推导。"
        }
      },
      "additionalProperties": false
    },
    "documentIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }
  },
  "required": ["message", "arguments", "documentIds"]
}
